{
	"name": "@ai-outfitter/channels",
	"version": "1.2.0",
	"description": "Pi extension that pushes channel events (email/Slack/Signal/…) into an agent session, waking it only when real work arrives.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ai-outfitter/channels.git"
	},
	"homepage": "https://github.com/ai-outfitter/channels#readme",
	"bugs": "https://github.com/ai-outfitter/channels/issues",
	"keywords": [
		"pi-package",
		"ai-outfitter",
		"channels"
	],
	"files": [
		"extensions",
		"docs"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts",
			"./extensions/relay-extension.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev:slack": "bash dev/run-slack-local.sh",
		"dev:slack:cli": "bash dev/run-slack-cli-local.sh",
		"setup:slack": "bash dev/setup-slack-cli-app.sh",
		"verify:slack": "node --experimental-strip-types dev/slack-verify.ts",
		"relay": "node --experimental-strip-types extensions/relay/server.ts",
		"lint": "biome check dev/*.ts extensions/ tests/",
		"format": "biome check --write dev/*.ts extensions/ tests/",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-strip-types tests/*.test.ts",
		"check": "biome check dev/*.ts extensions/ tests/ && tsc --noEmit && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^22.20.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@slack/socket-mode": "^3.0.0",
		"@slack/web-api": "^8.0.0",
		"typebox": "^1.3.8",
		"undici": "^7.29.0"
	}
}
